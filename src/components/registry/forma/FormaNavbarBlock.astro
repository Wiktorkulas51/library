---
// Why: Port of the Forma SiteNavbar. Scroll progress is set by the shared
// header-scroll-progress.js, so this block keeps only the mobile menu script.
// Forma colors and frame sizes are declared on the root so the block renders the
// same inside the library, where global tokens use other values.
import { formatInternalLink } from "@utils/url";
import data from "@data/sections/forma-navbar.json";

type NavbarData = typeof data;

export interface Props {
  data?: NavbarData;
  class?: string;
}

const { data: overrideData, class: className = "" } = Astro.props as Props;
const t = overrideData ?? data;
const menuId = "forma-navbar-menu";
---

<header
  data-forma-navbar
  data-header-progress
  data-header-progress-distance="220"
  class:list={["forma-navbar", className]}
>
  <a href={formatInternalLink(t.homeHref)} class="forma-navbar__wordmark" aria-label={t.homeLabel}>
    <img src={t.logoSrc} alt={t.logoAlt} width="768" height="146" decoding="async" />
  </a>

  <nav class="forma-navbar__nav" aria-label={t.navLabel}>
    {t.links.map((link) => (
      <a href={formatInternalLink(link.href)} class="forma-navbar__link">{link.label}</a>
    ))}
  </nav>

  <a href={formatInternalLink(t.cta.href)} class="forma-navbar__cta">{t.cta.label}<span class="forma-arrow-loop" aria-hidden="true"><span class="forma-arrow-loop__out">↗</span><span class="forma-arrow-loop__in">↗</span></span></a>

  <button
    type="button"
    class="forma-navbar__toggle"
    data-forma-navbar-toggle
    data-open-label={t.menuOpenLabel}
    data-close-label={t.menuCloseLabel}
    aria-controls={menuId}
    aria-expanded="false"
    aria-label={t.menuOpenLabel}
  >
    <span aria-hidden="true"></span>
    <span aria-hidden="true"></span>
  </button>

  <div class="forma-navbar__menu" id={menuId} data-forma-navbar-menu hidden>
    <nav aria-label={t.navLabel}>
      {t.links.map((link) => (
        <a href={formatInternalLink(link.href)} class="forma-navbar__link">{link.label}</a>
      ))}
      <a href={formatInternalLink(t.cta.href)} class="forma-navbar__menu-cta">{t.cta.label}<span class="forma-arrow-loop" aria-hidden="true"><span class="forma-arrow-loop__out">↗</span><span class="forma-arrow-loop__in">↗</span></span></a>
    </nav>
  </div>
</header>

<script is:inline data-astro-rerun src="/js/header-scroll-progress.js"></script>
<script is:inline data-astro-rerun src="/js/forma-navbar.js"></script>

<style>
  .forma-navbar {
    --color-brand-primary: #d07a3b;
    --color-brand-primary-hover: #ca7538;
    --color-brand-dark: #22221f;
    --color-brand-light: #f3f0e9;
    --color-surface: #ffffff;
    --color-outline-variant: #ddd8cf;
    --color-on-primary: #22221f;
    --ui-elevation-soft: 0 8px 30px rgb(20 20 18 / 0.06);
    --ui-button-radius: 1rem;
    --home-frame-width: 94rem;
    --home-frame-gutters: 2rem;
    --home-content-width: 88rem;
    --home-content-gutters: 4rem;
    --home-nav-compact-width: calc(var(--home-content-width) - 4rem);
    --home-nav-compact-gutters: calc(var(--home-content-gutters) + 2rem);
    --nav-scroll-progress: 0;

    position: sticky;
    top: calc(1.25rem - var(--nav-scroll-progress) * 0.5rem);
    z-index: 30;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    width: calc(100% - var(--home-frame-gutters) - var(--nav-scroll-progress) * (var(--home-nav-compact-gutters) - var(--home-frame-gutters)));
    max-width: calc(var(--home-frame-width) - var(--nav-scroll-progress) * (var(--home-frame-width) - var(--home-nav-compact-width)));
    min-height: calc(4.5rem - var(--nav-scroll-progress) * 0.5rem);
    margin: 0 auto 1.25rem;
    padding: 0.5rem 0.65rem 0.5rem 1.5rem;
    border: 1px solid color-mix(in srgb, var(--color-brand-dark) 6%, transparent);
    border-radius: calc(1.5rem - var(--nav-scroll-progress) * 0.5rem);
    background: var(--color-surface);
    color: var(--color-brand-dark);
    box-shadow: 0 calc(0.25rem + var(--nav-scroll-progress) * 0.4rem) calc(1.5rem + var(--nav-scroll-progress) * 0.75rem) rgb(34 33 31 / calc(0.045 + var(--nav-scroll-progress) * 0.035));
    transform: translateY(calc(var(--nav-scroll-progress) * -0.125rem));
    transition: box-shadow 180ms ease-out;
  }

  .forma-navbar__wordmark {
    display: inline-flex;
    flex-shrink: 0;
    align-items: center;
    text-decoration: none;
  }

  .forma-navbar__wordmark img {
    display: block;
    width: calc(clamp(5rem, 24vw, 9rem) - var(--nav-scroll-progress) * 0.4rem);
    height: auto;
  }

  .forma-navbar__nav {
    display: none;
    align-items: center;
    gap: clamp(1.25rem, 2.3vw, 2.25rem);
  }

  .forma-navbar__link {
    font-size: 0.875rem;
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.01em;
  }

  .forma-navbar__nav a,
  .forma-navbar__menu a {
    color: var(--color-brand-dark);
    text-decoration: none;
    transition: color 160ms ease;
  }

  .forma-navbar__nav a:hover,
  .forma-navbar__menu a:not(.forma-navbar__menu-cta):hover {
    color: var(--color-brand-primary);
  }

  .forma-navbar__cta,
  .forma-navbar__menu-cta {
    display: inline-flex;
    min-height: 2.9rem;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    padding-inline: 1.2rem;
    border-radius: var(--ui-button-radius);
    background: var(--color-brand-primary);
    color: var(--color-brand-dark);
    font-size: 15px;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-decoration: none;
    transition: background-color 220ms cubic-bezier(0.22, 1, 0.36, 1), color 220ms ease;
  }

  .forma-navbar__cta span,
  .forma-navbar__menu-cta span {
    font-size: 1.1rem;
  }

  .forma-navbar__cta:is(:hover, :focus-visible),
  .forma-navbar__menu-cta:is(:hover, :focus-visible) {
    background: var(--color-brand-dark);
    color: var(--color-surface);
  }

  /* Strzałka: wylatuje w swoim kierunku, a druga wlatuje z przeciwnej strony. */
  .forma-navbar :is(.forma-navbar__cta, .forma-navbar__menu-cta) .forma-arrow-loop {
    position: relative;
    display: inline-flex;
    width: 1.1em;
    height: 1.1em;
    overflow: hidden;
  }

  .forma-navbar :is(.forma-navbar__cta, .forma-navbar__menu-cta) :is(.forma-arrow-loop__out, .forma-arrow-loop__in) {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    line-height: 1;
    transition: transform 180ms ease-out;
  }

  .forma-navbar :is(.forma-navbar__cta, .forma-navbar__menu-cta) .forma-arrow-loop__in {
    transform: translate(-140%, 140%);
  }

  .forma-navbar :is(.forma-navbar__cta, .forma-navbar__menu-cta):is(:hover, :focus-visible) :is(.forma-arrow-loop__out, .forma-arrow-loop__in) {
    color: var(--color-brand-primary);
    transition-duration: 300ms;
  }

  .forma-navbar :is(.forma-navbar__cta, .forma-navbar__menu-cta):is(:hover, :focus-visible) .forma-arrow-loop__out {
    transform: translate(140%, -140%);
  }

  .forma-navbar :is(.forma-navbar__cta, .forma-navbar__menu-cta):is(:hover, :focus-visible) .forma-arrow-loop__in {
    transform: translate(0, 0);
  }

  .forma-navbar__toggle {
    display: flex;
    width: 3rem;
    height: 3rem;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.35rem;
    border: 0;
    border-radius: 50%;
    background: var(--color-brand-light);
    color: var(--color-brand-dark);
  }

  .forma-navbar__toggle span {
    width: 1.15rem;
    height: 1px;
    background: currentColor;
  }

  .forma-navbar__menu {
    position: absolute;
    top: calc(100% + 0.55rem);
    right: 0;
    left: 0;
    border: 1px solid var(--color-outline-variant);
    border-radius: 1.5rem;
    background: var(--color-surface);
    padding: 1.15rem;
    box-shadow: var(--ui-elevation-soft);
  }

  .forma-navbar__menu[hidden] {
    display: none;
  }

  .forma-navbar__menu nav {
    display: grid;
    gap: 0.3rem;
  }

  .forma-navbar__menu nav > a:not(.forma-navbar__menu-cta) {
    padding: 0.85rem 0.5rem;
  }

  .forma-navbar__menu-cta {
    margin-top: 0.5rem;
  }

  .forma-navbar a:focus-visible,
  .forma-navbar__toggle:focus-visible {
    outline: 3px solid var(--color-brand-primary);
    outline-offset: 3px;
  }

  @media (max-width: 48rem) {
    .forma-navbar {
      top: 1rem;
      width: calc(100% - var(--home-frame-gutters));
      max-width: 88rem;
      min-height: 4.5rem;
      border-radius: 1.5rem;
      box-shadow: var(--ui-elevation-soft);
      transform: none;
      will-change: auto;
    }

    .forma-navbar__cta {
      display: none;
    }

    .forma-navbar__wordmark img {
      width: clamp(5rem, 24vw, 9rem);
    }
  }

  @media (min-width: 48rem) {
    .forma-navbar {
      gap: 1.5rem;
      padding-left: 1.75rem;
    }

    .forma-navbar__nav {
      display: flex;
    }

    .forma-navbar__cta {
      margin-left: auto;
    }

    .forma-navbar__toggle,
    .forma-navbar__menu {
      display: none;
    }

    .forma-navbar {
      padding-left: 1.75rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .forma-navbar a,
    .forma-navbar a span,
    .forma-navbar :is(.forma-arrow-loop__out, .forma-arrow-loop__in) {
      transition: none;
    }
  }
</style>
