---
// Dlaczego: port navbaru WebScale. Dropdowny dzielą jeden stage (wspólne tło,
// pill hovera i szerokość), a wszystkie kolory są zmiennymi --wsb-* na korzeniu,
// żeby motyw dało się przemalować bez edycji CSS. Dane pochodzą z JSON.
import Icon from "@components/ui/atoms/Icon.astro";
import { formatInternalLink } from "@utils/url";
import jsonData from "@data/sections/webscale-navbar.json";

type NavData = typeof jsonData;

export interface Props {
  data?: NavData;
  id?: string;
  class?: string;
}

const { data, id = "webscale-navbar", class: className = "" } = Astro.props as Props;
const t = data ?? jsonData;

// Dlaczego: szerokość i wyrównanie panelu są w danych panelu, a nie w JS,
// bo JS tylko odczytuje je z atrybutów przy pozycjonowaniu stage.
const panels = [
  { key: "services", label: t.services.label, items: t.services.items, width: "25rem", align: "start", compact: false, footer: null },
  { key: "templates", label: t.templates.label, items: t.templates.items, width: "22rem", align: "center", compact: true, footer: null },
  { key: "tools", label: t.tools.label, items: t.tools.items, width: "31rem", align: "center", compact: false, footer: { label: t.tools.allLabel, href: t.tools.allHref } },
];
const panelAll = { label: t.templates.allLabel, href: t.templates.allHref };
---

<div class:list={["wsb-nav", className]} id={id} data-wsb-navbar>
  <header class="wsb-nav__header fixed inset-x-0 top-0 z-50 w-full" data-wsb-header>
    <nav class="relative mx-auto flex max-w-7xl items-center justify-between p-6 lg:px-8" aria-label={t.navLabel}>
      <div class="flex lg:flex-1">
        <a href={formatInternalLink("/")} class="-m-1.5 p-1.5">
          <img class="h-10 w-auto" src={t.logoSrc} alt={t.logoAlt} width="640" height="111" fetchpriority="high" />
        </a>
      </div>

      <div class="flex lg:hidden">
        <button type="button" class="wsb-nav__toggle -m-2.5 inline-flex items-center justify-center rounded-md p-2.5" aria-label={t.menuToggleLabel} aria-controls={`${id}-mobile`} aria-expanded="false" data-wsb-menu-toggle>
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.7" stroke="currentColor" class="h-8 w-8" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5"></path>
          </svg>
        </button>
      </div>

      <div class="wsb-nav__desktop hidden items-center lg:flex lg:gap-5" data-wsb-desktop>
        <div class="relative flex items-center gap-0.5" data-wsb-links>
          <span class="wsb-nav__indicator" data-wsb-indicator aria-hidden="true"></span>

          {panels.map((panel) => (
            <div class="wsb-nav__item relative" data-wsb-item>
              <button type="button" class="wsb-nav__trigger" data-wsb-trigger data-wsb-panel-key={panel.key} aria-expanded="false" aria-controls={`${id}-${panel.key}`}>
                {panel.label}
                <svg class="wsb-nav__chevron" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                  <path d="M6 8L10 12L14 8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </button>
            </div>
          ))}

          {t.links.map((link) => (
            <a href={formatInternalLink(link.href)} class="wsb-nav__trigger" data-wsb-trigger>{link.label}</a>
          ))}

          <div class="wsb-nav__stage" data-wsb-stage data-open="false" aria-hidden="true">
            {panels.map((panel) => (
              <div id={`${id}-${panel.key}`} class="wsb-nav__panel" role="menu" data-wsb-panel={panel.key} data-wsb-width={panel.width} data-wsb-align={panel.align}>
                <div class="wsb-nav__card" data-wsb-card>
                  <span class="wsb-nav__card-indicator" data-wsb-card-indicator aria-hidden="true"></span>
                  <div class="wsb-nav__card-body">
                    {panel.items.map((item, index) => (
                      <a href={formatInternalLink(item.href)} class:list={["wsb-nav__menuitem", panel.compact && "wsb-nav__menuitem--compact"]} role="menuitem" data-wsb-menuitem style={`--wsb-item-delay: ${45 + index * 30}ms`}>
                        <span class:list={["wsb-nav__icon", panel.compact && "wsb-nav__icon--compact", index === 0 && "is-accent"]} aria-hidden="true">
                          <Icon name={item.icon} size={panel.compact ? "1.125rem" : "1.25rem"} />
                        </span>
                        <span class="min-w-0">
                          <span class="wsb-nav__menuitem-title">{item.label}</span>
                          <span class="wsb-nav__menuitem-desc">{item.description}</span>
                        </span>
                      </a>
                    ))}
                    {panel.key === "templates" && (
                      <a href={formatInternalLink(panelAll.href)} class="wsb-nav__menuitem wsb-nav__all" role="menuitem" data-wsb-menuitem>
                        {panelAll.label}
                        <Icon name="arrow-right" size="1rem" />
                      </a>
                    )}
                  </div>
                  {panel.footer && (
                    <div class="wsb-nav__card-foot">
                      <a href={formatInternalLink(panel.footer.href)} class="wsb-nav__menuitem wsb-nav__all" role="menuitem" data-wsb-menuitem>
                        {panel.footer.label}
                        <Icon name="arrow-right" size="1rem" />
                      </a>
                    </div>
                  )}
                </div>
              </div>
            ))}
          </div>
        </div>

        <div class="flex items-center gap-3">
          <a href={formatInternalLink(t.cta.href)} class="wsb-nav__cta ui-button">
            <span class="ui-button-text-wrap">
              <span class="ui-button-text-default">{t.cta.label}</span>
              <span class="ui-button-text-hover" aria-hidden="true">{t.cta.hoverText}</span>
            </span>
          </a>
        </div>
      </div>
    </nav>
  </header>

  <!-- Dlaczego: tło jest poza nagłówkiem, bo nagłówek ma z-index i backdrop-filter
       po przewinięciu; wewnątrz nagłówka tło przykryłoby karty dropdownów. -->
  <div class="wsb-nav__backdrop" data-wsb-backdrop aria-hidden="true"></div>

  <div id={`${id}-mobile`} class="wsb-nav__mobile" role="dialog" aria-modal="true" aria-hidden="true" aria-label={t.navLabel} data-wsb-mobile>
    <div class="wsb-nav__mobile-head">
      <a href={formatInternalLink("/")} class="-m-1.5 p-1.5">
        <img class="h-10 w-auto" src={t.logoSrc} alt={t.mobileLogoAlt} width="640" height="111" />
      </a>
      <button type="button" class="wsb-nav__toggle -m-2.5 rounded-md p-2.5" aria-label={t.menuCloseLabel} data-wsb-menu-close>
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.7" stroke="currentColor" class="h-8 w-8" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>
    </div>

    <div class="wsb-nav__mobile-body">
      <div class="wsb-nav__mobile-stack">
        <div class="wsb-nav__mobile-section">
          <span class="wsb-nav__mobile-label">{t.services.label}</span>
          {t.services.items.map((item) => (
            <a href={formatInternalLink(item.href)} class="wsb-nav__mobile-link wsb-nav__mobile-link--lg">{item.label}</a>
          ))}
        </div>

        <div class="wsb-nav__mobile-section wsb-nav__mobile-section--divided">
          <span class="wsb-nav__mobile-label wsb-nav__mobile-label--inset">{t.templates.label}</span>
          <div class="wsb-nav__mobile-box">
            {t.templates.items.map((item, index) => (
              <a href={formatInternalLink(item.href)} class="wsb-nav__mobile-link wsb-nav__mobile-link--row wsb-nav__mobile-link--leading">
                <span class:list={["wsb-nav__mobile-icon", index === 0 && "is-accent"]} aria-hidden="true">
                  <Icon name={item.icon} size="1rem" />
                </span>
                {item.label}
              </a>
            ))}
            <a href={formatInternalLink(t.templates.allHref)} class="wsb-nav__mobile-link wsb-nav__mobile-link--row wsb-nav__mobile-link--accent">
              {t.templates.allLabel}
              <Icon name="arrow-right" size="1rem" />
            </a>
          </div>
        </div>

        <div class="wsb-nav__mobile-section wsb-nav__mobile-section--divided">
          <span class="wsb-nav__mobile-label wsb-nav__mobile-label--inset">{t.tools.label}</span>
          {t.tools.items.map((item) => (
            <a href={formatInternalLink(item.href)} class="wsb-nav__mobile-link wsb-nav__mobile-link--row">
              <span>{item.label}</span>
              <Icon name="arrow-right" size="1rem" />
            </a>
          ))}
          <a href={formatInternalLink(t.tools.allHref)} class="wsb-nav__mobile-link wsb-nav__mobile-link--row wsb-nav__mobile-link--accent">
            {t.tools.allLabel}
            <Icon name="arrow-right" size="1rem" />
          </a>
        </div>

        <div class="wsb-nav__mobile-section wsb-nav__mobile-section--divided">
          {t.links.map((link) => (
            <a href={formatInternalLink(link.href)} class="wsb-nav__mobile-link wsb-nav__mobile-link--lg">{link.label}</a>
          ))}
        </div>

        <a href={formatInternalLink(t.cta.href)} class="wsb-nav__cta wsb-nav__cta--block ui-button">
          <span class="ui-button-text-wrap">
            <span class="ui-button-text-default">{t.cta.label}</span>
            <span class="ui-button-text-hover" aria-hidden="true">{t.cta.hoverText}</span>
          </span>
        </a>
      </div>
    </div>
  </div>
</div>

<script is:inline data-astro-rerun src="/js/webscale-navbar.js"></script>

<style>
  /* Dlaczego: wszystkie reguły są pod .wsb-nav, żeby styl nie wyciekł do innych
     podglądów biblioteki. Kolory idą przez zmienne, więc motyw nadpisuje się na korzeniu. */
  .wsb-nav {
    --wsb-primary: #2563EB;
    --wsb-primary-dark: #1E40AF;
    --wsb-primary-soft: color-mix(in srgb, var(--wsb-primary) 7%, transparent);
    --wsb-primary-tint: color-mix(in srgb, var(--wsb-primary) 10%, white);
    --wsb-ink: #0F172A;
    --wsb-text-soft: #334155;
    --wsb-muted: #64748B;
    --wsb-subtle: #94A3B8;
    --wsb-line: #E2E8F0;
    --wsb-tile: #F1F5F9;
    --wsb-surface: #F8FAFC;
    --wsb-card-shadow: 0 24px 70px rgb(15 23 42 / 0.14);
    --wsb-backdrop: color-mix(in srgb, #020617 14%, transparent);
    font-family: var(--font-sans);
    color: var(--wsb-ink);
  }

  .wsb-nav__header {
    border-bottom: 1px solid transparent;
    background: transparent;
    transition: background-color 300ms ease, border-color 300ms ease, box-shadow 300ms ease, backdrop-filter 300ms ease;
  }
  .wsb-nav__header.is-scrolled {
    border-color: rgb(255 255 255 / 0.1);
    background: rgb(255 255 255 / 0.7);
    -webkit-backdrop-filter: blur(24px);
    backdrop-filter: blur(24px);
    box-shadow: 0 1px 2px rgb(15 23 42 / 0.05);
  }
  /* Dlaczego: pełne krycie przy otwartym dropdownie zlewa pasek z kartą menu.
     Filtr rozmycia jest wyłączony, bo w Chrome przestawiał kolejność malowania karty. */
  .wsb-nav__header.is-dropdown-open {
    border-color: color-mix(in srgb, var(--wsb-line) 80%, transparent);
    background: rgb(255 255 255 / 0.96);
    -webkit-backdrop-filter: none;
    backdrop-filter: none;
    box-shadow: 0 12px 40px rgb(15 23 42 / 0.1);
  }

  .wsb-nav__toggle {
    color: var(--wsb-text-soft);
    transition: color 300ms ease;
  }
  .wsb-nav__toggle:hover {
    color: var(--wsb-primary);
  }

  .wsb-nav__indicator {
    position: absolute;
    top: 50%;
    left: 0;
    z-index: 0;
    width: 0;
    height: 2.75rem;
    border-radius: 0.75rem;
    background: var(--wsb-primary-soft);
    opacity: 0;
    pointer-events: none;
    transform: translateY(-50%);
    transition: left 240ms cubic-bezier(0.22, 1, 0.36, 1), width 240ms cubic-bezier(0.22, 1, 0.36, 1), opacity 160ms ease;
  }

  /* Dlaczego: most nad odstępem utrzymuje hover, gdy kursor idzie z triggera do karty. */
  .wsb-nav__item::after {
    content: "";
    position: absolute;
    top: 100%;
    right: 0;
    left: 0;
    height: 0.75rem;
  }

  .wsb-nav__trigger {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    gap: 0.375rem;
    border-radius: 0.75rem;
    padding: 0.75rem;
    background: none;
    border: 0;
    font-size: 0.875rem;
    line-height: 1.25rem;
    font-weight: 600;
    color: var(--wsb-ink);
    text-decoration: none;
    cursor: pointer;
    transition: color 300ms ease;
  }
  .wsb-nav__trigger:hover {
    color: var(--wsb-primary);
  }
  .wsb-nav__trigger:focus-visible {
    outline: none;
    box-shadow: 0 0 0 2px color-mix(in srgb, var(--wsb-primary) 30%, transparent);
  }

  .wsb-nav__chevron {
    width: 1rem;
    height: 1rem;
    color: var(--wsb-subtle);
    transition: transform 280ms cubic-bezier(0.16, 1, 0.3, 1), color 220ms ease;
  }
  .wsb-nav__item[data-open="true"] .wsb-nav__chevron {
    transform: rotate(180deg);
  }

  /* Wspólny stage: jedna warstwa przesuwa się pod aktywnym triggerem, a treść zmienia się wewnątrz. */
  .wsb-nav__stage {
    position: absolute;
    top: calc(100% + 0.75rem);
    left: var(--wsb-stage-left, 0px);
    z-index: 20;
    width: var(--wsb-stage-width, 31rem);
    pointer-events: none;
    opacity: 0;
    visibility: hidden;
    transform: translate3d(0, 0.85rem, 0) scale(0.975);
    filter: blur(0.25rem);
    transform-origin: top center;
    transition:
      left 240ms cubic-bezier(0.22, 1, 0.36, 1),
      width 240ms cubic-bezier(0.22, 1, 0.36, 1),
      opacity 260ms cubic-bezier(0.22, 1, 0.36, 1),
      transform 420ms cubic-bezier(0.16, 1, 0.3, 1),
      filter 360ms cubic-bezier(0.16, 1, 0.3, 1),
      visibility 0s linear 420ms;
  }
  .wsb-nav__stage[data-open="true"] {
    pointer-events: auto;
    opacity: 1;
    visibility: visible;
    transform: translate3d(0, 0, 0) scale(1);
    filter: blur(0);
    transition-delay: 0s;
  }
  /* Dlaczego: przy zmianie dropdownu szerokość przeskakuje, bo płynne przejście łamało długie polskie opisy. */
  .wsb-nav__stage.is-switching {
    transition:
      left 240ms cubic-bezier(0.22, 1, 0.36, 1),
      opacity 260ms cubic-bezier(0.22, 1, 0.36, 1),
      transform 420ms cubic-bezier(0.16, 1, 0.3, 1),
      filter 360ms cubic-bezier(0.16, 1, 0.3, 1),
      visibility 0s linear 420ms;
  }
  .wsb-nav__stage.is-switching .wsb-nav__panel,
  .wsb-nav__stage.is-switching .wsb-nav__menuitem {
    transition: none;
  }

  .wsb-nav__panel {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 220ms cubic-bezier(0.22, 1, 0.36, 1), visibility 0s linear 220ms;
  }
  .wsb-nav__panel.is-active {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transition-delay: 0s;
  }

  .wsb-nav__card {
    position: relative;
    overflow: hidden;
    border: 1px solid var(--wsb-line);
    border-radius: 1.5rem;
    background: #fff;
    box-shadow: var(--wsb-card-shadow);
  }

  .wsb-nav__card-indicator {
    position: absolute;
    top: var(--wsb-card-top, 0px);
    left: var(--wsb-card-left, 0px);
    z-index: 1;
    width: var(--wsb-card-width, 0px);
    height: var(--wsb-card-height, 0px);
    border-radius: 1rem;
    background: var(--wsb-primary-soft);
    box-shadow: 0 0.75rem 1.5rem color-mix(in srgb, var(--wsb-primary) 5%, transparent);
    opacity: 0;
    pointer-events: none;
    will-change: left, top, width, height;
    transition:
      left 240ms cubic-bezier(0.22, 1, 0.36, 1),
      top 240ms cubic-bezier(0.22, 1, 0.36, 1),
      width 240ms cubic-bezier(0.22, 1, 0.36, 1),
      height 240ms cubic-bezier(0.22, 1, 0.36, 1),
      opacity 160ms ease,
      box-shadow 240ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .wsb-nav__card-body {
    position: relative;
    display: grid;
    gap: 0.25rem;
    padding: 0.75rem;
  }

  .wsb-nav__card-foot {
    border-top: 1px solid var(--wsb-line);
    background: color-mix(in srgb, var(--wsb-surface) 70%, transparent);
    padding: 0.75rem;
  }

  .wsb-nav__menuitem {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    gap: 1rem;
    border-radius: 1rem;
    padding: 0.75rem;
    color: inherit;
    text-decoration: none;
    opacity: 0;
    transform: translate3d(0, 0.25rem, 0);
    transition:
      opacity 260ms cubic-bezier(0.22, 1, 0.36, 1),
      transform 360ms cubic-bezier(0.16, 1, 0.3, 1),
      background-color 260ms cubic-bezier(0.22, 1, 0.36, 1),
      color 260ms cubic-bezier(0.22, 1, 0.36, 1);
    transition-delay: var(--wsb-item-delay, 0ms);
  }
  .wsb-nav__menuitem--compact {
    gap: 0.75rem;
  }
  .wsb-nav__panel.is-active .wsb-nav__menuitem {
    opacity: 1;
    transform: translate3d(0, 0, 0);
  }
  .wsb-nav__menuitem:focus-visible {
    outline: none;
  }

  .wsb-nav__menuitem-title {
    display: block;
    font-weight: 600;
    color: var(--wsb-ink);
    transition: color 260ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  .wsb-nav__menuitem-desc {
    display: block;
    margin-top: 0.125rem;
    font-size: 0.8125rem;
    line-height: 1.25rem;
    color: var(--wsb-muted);
  }
  .wsb-nav__menuitem--compact .wsb-nav__menuitem-desc {
    font-size: 0.75rem;
  }
  .wsb-nav__menuitem:hover .wsb-nav__menuitem-title,
  .wsb-nav__menuitem:focus-visible .wsb-nav__menuitem-title {
    color: var(--wsb-primary);
  }

  .wsb-nav__icon {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 0.75rem;
    background: var(--wsb-tile);
    color: var(--wsb-text-soft);
    transition: background-color 280ms cubic-bezier(0.16, 1, 0.3, 1), color 280ms cubic-bezier(0.16, 1, 0.3, 1), transform 320ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  .wsb-nav__icon--compact {
    width: 2.5rem;
    height: 2.5rem;
  }
  .wsb-nav__icon.is-accent {
    background: var(--wsb-primary-tint);
    color: var(--wsb-primary);
  }
  .wsb-nav__menuitem:hover .wsb-nav__icon,
  .wsb-nav__menuitem:focus-visible .wsb-nav__icon {
    transform: translate3d(0, -0.1rem, 0) scale(1.03);
  }

  .wsb-nav__all {
    justify-content: space-between;
    margin-top: 0.5rem;
    padding: 0.625rem 0.75rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--wsb-primary);
  }
  .wsb-nav__card-foot .wsb-nav__all {
    margin-top: 0;
  }

  .wsb-nav__cta {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.375rem;
    height: 2.75rem;
    border-radius: 0.75rem;
    padding: 0 1.25rem;
    background: var(--wsb-primary);
    color: #fff;
    font-size: 0.875rem;
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
    transition: background-color 300ms ease, box-shadow 300ms ease;
  }
  .wsb-nav__cta:hover {
    background: var(--wsb-primary-dark);
  }
  .wsb-nav__cta:focus-visible {
    outline: none;
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--wsb-primary) 50%, transparent);
  }
  .wsb-nav__cta--block {
    width: 100%;
    height: 3rem;
    font-size: 1rem;
  }

  .wsb-nav__backdrop {
    position: fixed;
    right: 0;
    bottom: 0;
    left: 0;
    top: var(--wsb-backdrop-top, 5.5rem);
    z-index: 40;
    background: var(--wsb-backdrop);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 280ms cubic-bezier(0.22, 1, 0.36, 1), visibility 0s linear 280ms;
  }
  .wsb-nav__backdrop[data-open="true"] {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transition-delay: 0s;
  }

  /* Dlaczego: mobile jest pełnym ekranem poza nagłówkiem, więc nie dziedziczy przezroczystości paska. */
  .wsb-nav__mobile {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: none;
    flex-direction: column;
    background: #fff;
    color: var(--wsb-ink);
  }
  .wsb-nav__mobile.is-open {
    display: flex;
  }
  @media (min-width: 1024px) {
    .wsb-nav__mobile {
      display: none !important;
    }
  }
  .wsb-nav__mobile-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid var(--wsb-tile);
    padding: 1.5rem;
  }
  .wsb-nav__mobile-body {
    flex-grow: 1;
    overflow-y: auto;
    padding: 2rem 1.5rem;
  }
  .wsb-nav__mobile-stack {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    margin: 0 auto;
    max-width: 28rem;
