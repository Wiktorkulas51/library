---
interface Props {
	devTools?: boolean;
}

const { devTools = true } = Astro.props;
---

{import.meta.env.DEV && devTools && (
    <>
		<div id="vt-bar" hidden role="toolbar" aria-label="Narzędzie wariantów">
			<div id="vt-groups"></div>
			<button id="vt-expand" type="button" hidden aria-label="Pokaż narzędzie wariantów">Warianty</button>
		</div>
	</>
)}

<script>
	if (import.meta.env.DEV) {
		let loading = false;
		const loadToolbar = () => {
			if (!document.getElementById('vt-bar') || loading) return;
			loading = true;
			document.removeEventListener('astro:page-load', loadToolbar);
			Promise.all([import('../../styles/version-toolbar.css?inline'), import('../../utils/version-toolbar')])
				.then(([styles, toolbar]) => toolbar.startVersionToolbar(styles.default));
		};
		document.addEventListener('astro:page-load', loadToolbar);
		loadToolbar();
	}
</script>
