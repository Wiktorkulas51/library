---
import Text from '@components/ui/atoms/Text.astro';
import FilterTabs from '@components/ui/patterns/FilterTabs.astro';
import FormField from '@components/ui/patterns/FormField.astro';
import FormStatus from '@components/ui/patterns/FormStatus.astro';
import MobileDrawer from '@components/ui/patterns/MobileDrawer.astro';
import SearchField from '@components/ui/patterns/SearchField.astro';
import SelectDropdown from '@components/ui/patterns/SelectDropdown.astro';
import ToastFeedback from '@components/ui/patterns/ToastFeedback.astro';
import previewCopy from '@data/dev/component-library/ui-preview.json';
import Testimonials13 from '@components/integrations/21st/testimonials-13.tsx';
import MorphGallery from '@components/integrations/21st/morph-gallery.tsx';
import CircularSplitRoll from '@components/integrations/21st/circular-split-roll.tsx';
import CtaWithTextMarquee from '@components/integrations/21st/cta-with-text-marquee.tsx';
import GlassVideoHero from '@components/integrations/21st/glass-video-hero.tsx';
import ConnoisseurStackInteractor from '@components/integrations/21st/connoisseur-stack-interactor.tsx';
import BentoGallery from '@components/integrations/21st/bento-gallery.tsx';
import { AccordionDemo as Accordion } from '@components/integrations/21st/accordion.tsx';
import { DemoOne as InteractiveSelector } from '@components/integrations/21st/interactive-selector.tsx';
import { BeamsBackgroundDemo as BeamsBackground } from '@components/integrations/21st/beams-background.tsx';
import LoadingState from '@components/integrations/21st/loading-state.tsx';
import FilterGrid from '@components/integrations/21st/filter-grid.tsx';
import { TagsSelectorDemo as TagsSelector } from '@components/integrations/21st/tags-selector.tsx';
import { ComboboxDemo as Filters } from '@components/integrations/21st/filters.tsx';
import DashboardSidebar from '@components/integrations/21st/dashboard-sidebar.tsx';
import CoverflowCarousel from '@components/integrations/21st/coverflow-carousel.tsx';
import { CircularTestimonialsDemo as CircularTestimonials } from '@components/integrations/21st/circular-testimonials.tsx';
import ContactPage from '@components/integrations/21st/contact-page.tsx';
import { TimelineDemo as Timeline } from '@components/integrations/21st/timeline.tsx';
import TooltipGroup from '@components/integrations/21st/tooltip-group.tsx';
import ReactTailwindImageGallery from '@components/integrations/21st/react-tailwind-image-gallery.tsx';
import InfiniteCircularScroll from '@components/integrations/21st/infinite-circular-scroll.tsx';
import ScrollFadeEffect from '@components/integrations/21st/scroll-fade-effect.tsx';
import CircularGallery2 from '@components/integrations/21st/circular-gallery-2.tsx';
import { DemoOne as StickyScroll } from '@components/integrations/21st/sticky-scroll.tsx';

interface Props {
  previewId?: string;
}

const { previewId = 'search-field' } = Astro.props;
const currentPreviewId: string = previewId;
const isPreview = (id: string) => currentPreviewId === id;
---

<div class="ui-bg-page flex min-h-[22rem] w-full items-center justify-center p-6 sm:p-10" data-preview-id={currentPreviewId}>
  {isPreview('search-field') && (
    <SearchField
      id="catalog-search"
      class="w-full max-w-xl"
      label={previewCopy.search.label}
      placeholder={previewCopy.search.placeholder}
      hint={previewCopy.search.hint}
      actionLabel={previewCopy.search.buttonLabel}
    />
  )}

  {isPreview('select-dropdown') && (
    <SelectDropdown
      id="catalog-project-type"
      class="w-full max-w-sm"
      label={previewCopy.select.label}
      selectedId="service"
      options={[
        { id: 'service', label: previewCopy.select.optionOne },
        { id: 'landing', label: previewCopy.select.optionTwo },
        { id: 'shop', label: previewCopy.select.optionThree },
      ]}
    />
  )}

  {isPreview('filter-tabs') && (
    <div class="w-full max-w-2xl space-y-4">
      <div class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
        <Text variant="accent-label">{previewCopy.filters.label}</Text>
        <Text variant="body" class="text-sm text-brand-dark/55">{previewCopy.filters.activeCount}</Text>
</div>
      <FilterTabs
        label={previewCopy.filters.label}
        activeId="all"
        items={[
          { id: 'all', label: previewCopy.filters.all },
          { id: 'websites', label: previewCopy.filters.websites },
          { id: 'shops', label: previewCopy.filters.shops },
        ]}
      />
    </div>
  )}

  {isPreview('toast-feedback') && (
    <ToastFeedback
      class="max-w-md"
      title={previewCopy.toast.title}
      description={previewCopy.toast.description}
      closeLabel={previewCopy.toast.closeLabel}
    />
  )}

  {isPreview('form-field-error') && (
    <FormField
      id="catalog-email"
      class="w-full max-w-md"
      type="email"
      label={previewCopy.form.label}
      value={previewCopy.form.value}
      error={previewCopy.form.error}
      hint={previewCopy.form.hint}
    />
  )}

  {isPreview('form-statuses') && (
    <div class="grid w-full max-w-5xl gap-4 lg:grid-cols-3">
      <FormStatus type="loading" title={previewCopy.formStatus.loadingTitle} description={previewCopy.formStatus.loadingDescription} />
      <FormStatus type="success" title={previewCopy.formStatus.successTitle} description={previewCopy.formStatus.successDescription} />
      <FormStatus type="error" title={previewCopy.formStatus.errorTitle} description={previewCopy.formStatus.errorDescription} />
    </div>
  )}

  {isPreview('mobile-drawer') && (
    <MobileDrawer
      eyebrow={previewCopy.drawer.eyebrow}
      title={previewCopy.drawer.title}
      closeLabel={previewCopy.drawer.closeLabel}
      ctaLabel={previewCopy.drawer.cta}
      ctaHref="/kontakt/"
      links={[
        { href: '/', label: previewCopy.drawer.home },
        { href: '/uslugi/', label: previewCopy.drawer.services },
        { href: '/realizacje/', label: previewCopy.drawer.projects },
        { href: '/kontakt/', label: previewCopy.drawer.contact },
      ]}
    />
  )}
  {isPreview('21st-testimonials-13') && <Testimonials13 client:load />}
  {isPreview('21st-morph-gallery') && <MorphGallery client:load />}
  {isPreview('21st-circular-split-roll') && <CircularSplitRoll client:load />}
  {isPreview('21st-cta-with-text-marquee') && <CtaWithTextMarquee client:load />}
  {isPreview('21st-glass-video-hero') && <GlassVideoHero client:load />}
  {isPreview('21st-connoisseur-stack-interactor') && <ConnoisseurStackInteractor client:load />}
  {isPreview('21st-bento-gallery') && <BentoGallery client:load />}
  {isPreview('21st-accordion') && <Accordion client:load />}
  {isPreview('21st-interactive-selector') && <InteractiveSelector client:load />}
  {isPreview('21st-beams-background') && <BeamsBackground client:load />}
  {isPreview('21st-loading-state') && <LoadingState client:load />}
  {isPreview('21st-filter-grid') && <FilterGrid client:load />}
  {isPreview('21st-tags-selector') && <TagsSelector client:load />}
  {isPreview('21st-filters') && <Filters client:load />}
  {isPreview('21st-dashboard-sidebar') && <DashboardSidebar client:load />}
  {isPreview('21st-coverflow-carousel') && <CoverflowCarousel client:load />}
  {isPreview('21st-circular-testimonials') && <CircularTestimonials client:load />}
  {isPreview('21st-contact-page') && <ContactPage client:load />}
  {isPreview('21st-timeline') && <Timeline client:load />}
  {isPreview('21st-tooltip-group') && <TooltipGroup client:load />}
  {isPreview('21st-react-tailwind-image-gallery') && <ReactTailwindImageGallery client:load />}
  {isPreview('21st-infinite-circular-scroll') && <InfiniteCircularScroll client:load />}
  {isPreview('21st-scroll-fade-effect') && <ScrollFadeEffect client:load />}
  {isPreview('21st-circular-gallery-2') && <CircularGallery2 client:load />}
  {isPreview('21st-sticky-scroll') && <StickyScroll client:load />}
</div>
