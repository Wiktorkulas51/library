---
import ComponentGallery from '@components/dev/component-library/ComponentGallery.astro';
import { getDeveloperCatalogGroups, getDeveloperCatalogMetadata } from '@components/dev/component-library/component-catalog-metadata';

// Library categories map to groups from SECTION_GROUPS.
// The path /dev/components/library/<groupId>/ shows all variants
// The page resolves the selected group rather than a single registry entry.
export function getStaticPaths() {
  const catalog = getDeveloperCatalogMetadata();
  const groups = getDeveloperCatalogGroups()
    .filter((group) => catalog.some((item) => item.groupId === group.id))
    .map((group) => group.id);

  return groups.map((groupId) => ({
    params: { section: groupId },
    props: { catalog, activeSectionId: groupId },
  }));
}

if (!import.meta.env.DEV) {
  return new Response(null, { status: 404 });
}

const { catalog, activeSectionId } = Astro.props;
---

<ComponentGallery catalog={catalog} activeSectionId={activeSectionId} />
